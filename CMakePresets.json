{
  "version": 6,
  "configurePresets": [
    {
      "name": "mingw64",
      "displayName": "MSYS2 MinGW64 x64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw64-local",
      "environment": {
        "VULKAN_SDK": "C:/VulkanSDK/1.4.350.0"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/msys64/mingw64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/mingw64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/mingw64/bin/ninja.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/mingw64",
        "Vulkan_INCLUDE_DIR": "C:/VulkanSDK/1.4.350.0/Include",
        "Vulkan_LIBRARY": "C:/msys64/mingw64/lib/libvulkan-1.dll.a",
        "VulkanHpp_INCLUDE_DIR": "C:/VulkanSDK/1.4.350.0/Include",
        "VulkanHpp_CPPM_DIR": "C:/VulkanSDK/1.4.350.0/Include",
        "MINGW_PREFIX": "C:/msys64/mingw64",
        "ENABLE_CPP20_MODULE": "OFF",
        "ENABLE_COURSES": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw64-debug",
      "displayName": "MinGW64 Debug",
      "configurePreset": "mingw64"
    }
  ]
}
